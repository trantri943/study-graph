      "created": "2026-10-08"
    },
    "Intermittent Fasting": {
      "definition": "Eat in a time window (e.g., 8 h), fast the rest.",
      "example": "Metabolic switch: after ~12 h without food, glucose runs low → body burns fat → ketones (backup brain fuel) → BDNF ↑ — shown in mice.",
      "question": "Is fasting safe?",
      "answer": "12-h overnight is a gentle start for healthy adults; certain groups must ask a doctor."
    },
    "Being in Nature": {
      "definition": "Parks, forests, beaches.",
      "example": "Stanford 2015 (Bratman): 90-min nature walk → less rumination; city walk = no change.",
      "question": "Does a city park count?",
      "answer": "Yes; studies counted parks/green spaces."
    },
    "Limitations": {
      "definition": "SMALL (often <100 people), SHORT (hours–weeks, not years), LINKS (correlation ≠ causation).",
      "example": "Cal State LA 2024 student study, 18 people.",
      "question": "Why nature 4/5 not 5?",
      "answer": "Small, short-term, some only correlations."
    },
    "The Answer & Weekly Plan": {
      "definition": "Both can help, but the proof is not equal. Fasting = 2/5, Nature = 4/5 (presenter's own summary, not a published score).",
      "example": "Every night 12-h overnight fast (dinner 7 pm → breakfast 7 am); 3× a week 40 min outdoors = 120 min.",
      "question": "Do both together?",
      "answer": "Yes, e.g., morning park walk before breakfast; start slowly."
    },
    "References & Source Quality": {
      "definition": "Peer-reviewed journal > book > student project.",
      "example": "On CSULB OneSearch, filter \"Peer-reviewed Journals\"; \"Source: CSU_SCHOLARWORKS\" usually = student work.",
      "question": "Sources?",
      "answer": "Peer-reviewed journals + CSULB library; listed on last slides."
    },
    "Slide Design": {
      "definition": "One message per slide; no full sentences to read (redundancy effect); most important = biggest; guide focus with contrast; max ~6 objects.",
      "example": "Subitizing (Kaufman et al., 1949); working memory ≈ 4±1 chunks (Cowan, 2001)."
    }
  },
